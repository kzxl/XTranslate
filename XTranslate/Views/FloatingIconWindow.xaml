<Window x:Class="XTranslate.Views.FloatingIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="36" Height="36"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        Focusable="False" ShowActivated="False"
        Deactivated="Window_Deactivated">

    <Border x:Name="IconBorder" CornerRadius="18" Cursor="Hand"
            Background="#FF6C63FF"
            MouseLeftButtonDown="Icon_Click"
            MouseEnter="Icon_MouseEnter"
            MouseLeave="Icon_MouseLeave"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.4" Color="Black" />
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>

        <!-- Translate icon (🌐 globe) -->
        <TextBlock Text="🌐" FontSize="18" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="0,-1,0,0" />
    </Border>
</Window>
