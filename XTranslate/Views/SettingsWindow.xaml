<Window x:Class="XTranslate.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XTranslate — Cài đặt"
        Width="500" Height="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgPrimaryBrush}"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="⚙ Cài đặt" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20" />

        <!-- Settings Content -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">

            <!-- Hotkey -->
            <TextBlock Text="Phím tắt dịch nhanh" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
            <Border Background="{StaticResource BgPanelBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="txtHotkey" Text="Ctrl + Q" FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="  (Không thể thay đổi trong phiên bản hiện tại)" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Default target language -->
            <TextBlock Text="Ngôn ngữ đích mặc định" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
            <ComboBox x:Name="cboTargetLang" Style="{StaticResource ModernComboBox}"
                      DisplayMemberPath="Name" Width="200" HorizontalAlignment="Left"
                      Margin="0,0,0,16" />

            <!-- Checkboxes -->
            <CheckBox x:Name="chkMinimizeToTray" Content="Thu nhỏ xuống khay hệ thống"
                      Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                      Margin="0,0,0,8" />
            <CheckBox x:Name="chkStartMinimized" Content="Khởi động thu nhỏ"
                      Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                      Margin="0,0,0,8" />
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Style="{StaticResource ModernButton}" 
                    Click="CancelButton_Click" Padding="16,8" Margin="0,0,8,0" />
            <Button Content="✓ Lưu" Style="{StaticResource AccentButton}" 
                    Click="SaveButton_Click" Padding="20,8" />
        </StackPanel>
    </Grid>
</Window>
