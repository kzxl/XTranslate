<Window x:Class="XTranslate.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XTranslate — Cài đặt"
        Width="540" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgPrimaryBrush}"
        ResizeMode="NoResize">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="⚙  Cài đặt" FontSize="22" FontWeight="Bold"
                       Foreground="#FFFFFFFF" />
            <TextBlock Text="Tùy chỉnh hành vi và giao diện của XTranslate" FontSize="12"
                       Foreground="#FF8989A8" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>

                <!-- == Section: Chung == -->
                <TextBlock Text="CHUNG" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,0,10"
                           />

                <!-- Hotkey display -->
                <TextBlock Text="Phím tắt dịch nhanh (Popup)" FontSize="13"
                           Foreground="#FFBBBBD4" Margin="0,0,0,6" />
                <Border Background="#FF272850" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#FF3A3A60" CornerRadius="4" Padding="8,3">
                            <TextBlock Text="Ctrl + Q" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#FFFFFFFF" />
                        </Border>
                        <TextBlock Text="  Chọn text bất kỳ → nhấn phím tắt" FontSize="11"
                                   Foreground="#FF8989A8" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Default target language -->
                <TextBlock Text="Ngôn ngữ đích mặc định" FontSize="13"
                           Foreground="#FFBBBBD4" Margin="0,0,0,6" />
                <ComboBox x:Name="cboTargetLang"
                          Width="220" HorizontalAlignment="Left"
                          FontSize="13" Padding="12,8"
                          Background="#FF2A2C52" Foreground="#FFFFFFFF"
                          BorderBrush="#FF454570" BorderThickness="1"
                          Margin="0,0,0,16">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Foreground="#FFFFFFFF" FontSize="13" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Separator -->
                <Rectangle Height="1" Fill="#FF3A3A60" Margin="0,4,0,18" />

                <!-- == Section: Hành vi == -->
                <TextBlock Text="HÀNH VI" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,0,12"
                           />

                <CheckBox x:Name="chkMinimizeToTray" Content="Thu nhỏ xuống khay hệ thống khi đóng"
                          Foreground="#FFFFFFFF" FontSize="13" Margin="0,0,0,10" />
                <CheckBox x:Name="chkStartMinimized" Content="Khởi động ở chế độ thu nhỏ"
                          Foreground="#FFFFFFFF" FontSize="13" Margin="0,0,0,10" />
                <CheckBox x:Name="chkShowFloatingIcon" Content="Hiện icon dịch nhanh 🌐 khi chọn text"
                          Foreground="#FFFFFFFF" FontSize="13" Margin="0,0,0,10" />

                <!-- Separator -->
                <Rectangle Height="1" Fill="#FF3A3A60" Margin="0,8,0,18" />

                <!-- == Section: Nâng cao == -->
                <TextBlock Text="NÂNG CAO" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,0,12"
                           />

                <!-- Translation engine -->
                <TextBlock Text="Engine dịch" FontSize="13"
                           Foreground="#FFBBBBD4" Margin="0,0,0,6" />
                <ComboBox x:Name="cboEngine"
                          Width="220" HorizontalAlignment="Left"
                          FontSize="13" Padding="12,8"
                          Background="#FF2A2C52" Foreground="#FFFFFFFF"
                          BorderBrush="#FF454570" BorderThickness="1"
                          Margin="0,0,0,14" />

                <!-- Auto-start -->
                <CheckBox x:Name="chkStartWithWindows" Content="Tự động chạy khi khởi động Windows"
                          Foreground="#FFFFFFFF" FontSize="13" Margin="0,0,0,10" />

                <!-- Popup auto-close delay -->
                <TextBlock Text="Popup tự đóng sau (giây)" FontSize="13"
                           Foreground="#FFBBBBD4" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBox x:Name="txtPopupDelay" Width="80"
                             FontSize="13" Padding="10,8"
                             Background="#FF272850" Foreground="#FFFFFFFF"
                             BorderBrush="#FF454570" BorderThickness="1"
                             Text="5" />
                    <TextBlock Text="  0 = không tự đóng" FontSize="11"
                               Foreground="#FF8989A8" VerticalAlignment="Center" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Style="{StaticResource ModernButton}" 
                    Click="CancelButton_Click" Padding="18,9" Margin="0,0,10,0" FontSize="13" />
            <Button Content="✓  Lưu cài đặt" Style="{StaticResource AccentButton}" 
                    Click="SaveButton_Click" Padding="22,9" FontSize="13" />
        </StackPanel>
    </Grid>
</Window>
