<Window x:Class="XTranslate.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XTranslate — Cài đặt"
        Width="540" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgPrimaryBrush}"
        ResizeMode="NoResize">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="⚙  Cài đặt" FontSize="22" FontWeight="Bold"
                       Foreground="#FFF1F5F9" />
            <TextBlock Text="Tùy chỉnh hành vi và giao diện" FontSize="12"
                       Foreground="#FF64748B" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>

                <!-- SECTION: PHÍM TẮT -->
                <TextBlock Text="PHÍM TẮT" FontSize="11" FontWeight="Bold"
                           Foreground="#FF818CF8" Margin="0,0,0,10" />

                <TextBlock Text="Phím tắt dịch nhanh (Popup)" FontSize="13"
                           Foreground="#FF94A3B8" Margin="0,0,0,6" />

                <Border Background="#FF1E2030" CornerRadius="8" Padding="14,10" Margin="0,0,0,6"
                        BorderBrush="#FF334155" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtHotkey" Grid.Column="0"
                                 IsReadOnly="True" FontSize="14" FontWeight="SemiBold"
                                 Background="Transparent" Foreground="#FFF1F5F9"
                                 BorderThickness="0" Cursor="Hand"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                 GotFocus="HotkeyBox_GotFocus"
                                 LostFocus="HotkeyBox_LostFocus"
                                 ToolTip="Click vào đây rồi nhấn tổ hợp phím mới" />
                        <TextBlock Grid.Column="1" x:Name="txtHotkeyHint"
                                   Text="Click để đổi" FontSize="11"
                                   Foreground="#FF64748B" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Text="Nhấn vào ô, sau đó bấm tổ hợp phím muốn dùng (vd: Ctrl+D)" FontSize="11"
                           Foreground="#FF475569" Margin="4,0,0,14" />

                <Rectangle Height="1" Fill="#FF1E293B" Margin="0,4,0,18" />

                <!-- SECTION: NGÔN NGỮ -->
                <TextBlock Text="NGÔN NGỮ" FontSize="11" FontWeight="Bold"
                           Foreground="#FF818CF8" Margin="0,0,0,10" />

                <TextBlock Text="Ngôn ngữ đích mặc định" FontSize="13"
                           Foreground="#FF94A3B8" Margin="0,0,0,6" />
                <ComboBox x:Name="cboTargetLang" Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          DisplayMemberPath="Name"
                          Width="240" HorizontalAlignment="Left"
                          Margin="0,0,0,16" />

                <Rectangle Height="1" Fill="#FF1E293B" Margin="0,4,0,18" />

                <!-- SECTION: HÀNH VI -->
                <TextBlock Text="HÀNH VI" FontSize="11" FontWeight="Bold"
                           Foreground="#FF818CF8" Margin="0,0,0,12" />

                <CheckBox x:Name="chkMinimizeToTray" Content="Thu nhỏ xuống khay hệ thống khi đóng"
                          Margin="0,0,0,10" />
                <CheckBox x:Name="chkStartMinimized" Content="Khởi động ở chế độ thu nhỏ"
                          Margin="0,0,0,10" />
                <CheckBox x:Name="chkShowFloatingIcon" Content="Hiện icon 🌐 khi chọn text (floating icon)"
                          Margin="0,0,0,10" />

                <Rectangle Height="1" Fill="#FF1E293B" Margin="0,8,0,18" />

                <!-- SECTION: OCR -->
                <TextBlock Text="OCR (NHẬN DẠNG CHỮ)" FontSize="11" FontWeight="Bold"
                           Foreground="#FF818CF8" Margin="0,0,0,12" />

                <CheckBox x:Name="chkOcrEnabled" Content="Bật OCR — chụp màn hình và dịch"
                          Margin="0,0,0,10" />

                <TextBlock Text="Ngôn ngữ OCR" FontSize="13"
                           Foreground="#FF94A3B8" Margin="0,0,0,6" />
                <ComboBox x:Name="cboOcrLang" Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          Width="240" HorizontalAlignment="Left"
                          Margin="0,0,0,10" />

                <TextBlock Text="Phím tắt OCR" FontSize="13"
                           Foreground="#FF94A3B8" Margin="0,0,0,6" />
                <Border Background="#FF1E2030" CornerRadius="8" Padding="14,8" Margin="0,0,0,6"
                        BorderBrush="#FF334155" BorderThickness="1" HorizontalAlignment="Left" MinWidth="200">
                    <TextBlock x:Name="txtOcrHotkey" FontSize="13" Foreground="#FF94A3B8" />
                </Border>
                <TextBlock Text="Thay đổi phím tắt OCR trong tương lai" FontSize="11"
                           Foreground="#FF475569" Margin="4,0,0,14" />

                <Rectangle Height="1" Fill="#FF1E293B" Margin="0,8,0,18" />

                <!-- SECTION: NÂNG CAO -->
                <TextBlock Text="NÂNG CAO" FontSize="11" FontWeight="Bold"
                           Foreground="#FF818CF8" Margin="0,0,0,12" />

                <TextBlock Text="Engine dịch" FontSize="13"
                           Foreground="#FF94A3B8" Margin="0,0,0,6" />
                <ComboBox x:Name="cboEngine" Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          Width="240" HorizontalAlignment="Left"
                          Margin="0,0,0,14" />

                <TextBlock Text="Popup tự đóng sau (giây, 0 = không tự đóng)" FontSize="13"
                           Foreground="#FF94A3B8" Margin="0,0,0,6" />
                <TextBox x:Name="txtPopupDelay" Width="80" HorizontalAlignment="Left"
                         FontSize="13" Padding="10,8"
                         Background="#FF1E2030" Foreground="#FFF1F5F9"
                         BorderBrush="#FF334155" BorderThickness="1"
                         Text="5" Margin="0,0,0,14" />

                <CheckBox x:Name="chkStartWithWindows" Content="Tự động chạy khi khởi động Windows"
                          Margin="0,0,0,10" />

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Style="{StaticResource ModernButton}" 
                    Click="CancelButton_Click" Padding="18,9" Margin="0,0,10,0" FontSize="13" />
            <Button Content="✓  Lưu cài đặt" Style="{StaticResource AccentButton}" 
                    Click="SaveButton_Click" Padding="22,9" FontSize="13" />
        </StackPanel>
    </Grid>
</Window>
