<Window x:Class="XTranslate.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XTranslate Popup"
        Width="440" SizeToContent="Height"
        MaxHeight="380"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded">

    <Border CornerRadius="14" Margin="10"
            Background="#E8161822"
            BorderBrush="#50818CF8" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="#FF0A0B10" />
        </Border.Effect>

        <Grid Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- Header -->
                <RowDefinition Height="Auto" />   <!-- Source text -->
                <RowDefinition Height="Auto" />   <!-- Divider -->
                <RowDefinition Height="*" />       <!-- Translated text -->
                <RowDefinition Height="Auto" />   <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header with gradient accent line -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✦" FontSize="15" Foreground="{StaticResource AccentPrimaryBrush}" 
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="XTranslate" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DetectedLanguage, StringFormat='  •  {0}'}" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Source text (truncated) -->
            <TextBlock Grid.Row="1" Text="{Binding SourceText}" 
                       TextTrimming="CharacterEllipsis" MaxHeight="40"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"
                       TextWrapping="Wrap" Margin="0,0,0,10" />

            <!-- Gradient divider -->
            <Border Grid.Row="2" Height="1" Margin="0,0,0,10" CornerRadius="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF818CF8" Offset="0" />
                        <GradientStop Color="#40818CF8" Offset="0.5" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Translated text / Loading -->
            <Grid Grid.Row="3" MinHeight="44">
                <!-- Loading animation -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="⟳" FontSize="14" Foreground="{StaticResource AccentPrimaryBrush}"
                               Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                            Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="360" Duration="0:0:0.7" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="Đang dịch..." FontSize="13"
                               Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Result -->
                <TextBlock Text="{Binding TranslatedText}" 
                           TextWrapping="Wrap" FontSize="14.5" LineHeight="23"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           MaxHeight="220">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTranslating}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="4" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <ComboBox Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SourceLanguage}"
                              DisplayMemberPath="Name"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              Width="100" Height="28" FontSize="11" />

                    <Button Content="⇄" FontSize="12" Margin="4,0"
                            Style="{StaticResource ModernButton}"
                            Command="{Binding SwapLanguagesCommand}"
                            Padding="6,0" Height="28" ToolTip="Đảo ngôn ngữ" />

                    <ComboBox Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding TargetLanguage}"
                              DisplayMemberPath="Name"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              Width="100" Height="28" FontSize="11" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📋 Copy" Style="{StaticResource ModernButton}"
                            Command="{Binding CopyCommand}"
                            Padding="10,3" FontSize="11" Height="28" />
                    <TextBlock Text="Esc đóng" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
