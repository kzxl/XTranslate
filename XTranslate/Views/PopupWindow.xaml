<Window x:Class="XTranslate.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XTranslate Popup"
        Width="420" SizeToContent="Height"
        MaxHeight="350"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded">

    <Border CornerRadius="12" Margin="8"
            Background="{StaticResource BgSecondaryBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- Header -->
                <RowDefinition Height="Auto" />   <!-- Source text -->
                <RowDefinition Height="Auto" />   <!-- Divider -->
                <RowDefinition Height="*" />       <!-- Translated text -->
                <RowDefinition Height="Auto" />   <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="✦" FontSize="14" Foreground="{StaticResource AccentPrimaryBrush}" 
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="XTranslate" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DetectedLanguage, StringFormat='  •  {0}'}" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Source text (truncated) -->
            <TextBlock Grid.Row="1" Text="{Binding SourceText}" 
                       TextTrimming="CharacterEllipsis" MaxHeight="40"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,8" />

            <!-- Divider -->
            <Rectangle Grid.Row="2" Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,8" />

            <!-- Translated text / Loading -->
            <Grid Grid.Row="3" MinHeight="40">
                <!-- Loading -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="⟳ Đang dịch..." FontSize="13"
                               Foreground="{StaticResource AccentPrimaryBrush}" />
                </StackPanel>

                <!-- Result -->
                <TextBlock Text="{Binding TranslatedText}" 
                           TextWrapping="Wrap" FontSize="14" LineHeight="22"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           MaxHeight="200">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTranslating}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="4" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <!-- Source Language -->
                    <ComboBox Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SourceLanguage}"
                              DisplayMemberPath="Name"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              Width="95" Height="26" FontSize="11" />
                    
                    <Button Content="⇄" FontSize="12" Margin="4,0"
                            Style="{StaticResource ModernButton}"
                            Command="{Binding SwapLanguagesCommand}"
                            Padding="6,0" Height="26" ToolTip="Đảo ngôn ngữ" />

                    <!-- Target Language -->
                    <ComboBox Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding TargetLanguage}"
                              DisplayMemberPath="Name"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              Width="95" Height="26" FontSize="11" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📋 Copy" Style="{StaticResource ModernButton}"
                            Command="{Binding CopyCommand}"
                            Padding="8,2" FontSize="11" Height="26" />
                    <TextBlock Text="Esc đóng" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
