<Window x:Class="XTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XTranslate" 
        Height="560" Width="900" MinHeight="420" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Header -->
            <RowDefinition Height="Auto" />   <!-- Language bar -->
            <RowDefinition Height="*" />       <!-- Translation panels -->
            <RowDefinition Height="Auto" />   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Padding="20,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF181930" Offset="0" />
                    <GradientStop Color="#FF252648" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✦" FontSize="22" Foreground="{StaticResource AccentPrimaryBrush}" 
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="XTranslate" FontSize="20" FontWeight="Bold" 
                               Foreground="#FFFFFFFF" VerticalAlignment="Center" />
                    <Border Background="#30FFFFFF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="v1.0" FontSize="10" Foreground="#AAFFFFFF" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="⚙ Cài đặt" Style="{StaticResource ModernButton}"
                            Click="SettingsButton_Click" Padding="14,7" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== LANGUAGE SELECTOR BAR ===== -->
        <Border Grid.Row="1" Padding="20,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF1C1D38" Offset="0" />
                    <GradientStop Color="#FF222344" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Source language -->
                <ComboBox Grid.Column="0" x:Name="cboSource"
                          ItemsSource="{Binding SourceLanguages}"
                          SelectedItem="{Binding SourceLanguage}"
                          HorizontalAlignment="Center" MinWidth="200"
                          FontSize="14" Padding="12,8"
                          Background="#FF2A2C52" Foreground="#FFFFFFFF"
                          BorderBrush="#FF454570" BorderThickness="1">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Foreground="#FFFFFFFF" FontSize="13" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Swap button -->
                <Button Grid.Column="1" Content="⇄" FontSize="20" FontWeight="Bold"
                        Style="{StaticResource ModernButton}"
                        Command="{Binding SwapLanguagesCommand}"
                        Padding="14,6" Margin="12,0"
                        ToolTip="Đổi ngôn ngữ nguồn ↔ đích" />

                <!-- Target language -->
                <ComboBox Grid.Column="2" x:Name="cboTarget"
                          ItemsSource="{Binding TargetLanguages}"
                          SelectedItem="{Binding TargetLanguage}"
                          HorizontalAlignment="Center" MinWidth="200"
                          FontSize="14" Padding="12,8"
                          Background="#FF2A2C52" Foreground="#FFFFFFFF"
                          BorderBrush="#FF454570" BorderThickness="1">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Foreground="#FFFFFFFF" FontSize="13" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <!-- ===== TRANSLATION PANELS ===== -->
        <Grid Grid.Row="2" Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Source panel -->
            <Border Grid.Column="0" Background="#FF1E2045" CornerRadius="10"
                    BorderBrush="#FF3A3A60" BorderThickness="1" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Panel header -->
                    <Border Grid.Row="0" Padding="14,10" 
                            BorderBrush="#FF3A3A60" BorderThickness="0,0,0,1">
                        <TextBlock Text="VĂN BẢN GỐC" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource AccentPrimaryBrush}" 
                                   />
                    </Border>

                    <!-- Source text -->
                    <TextBox Grid.Row="1" 
                             Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" Foreground="#FFFFFFFF"
                             BorderThickness="0" Padding="14,10"
                             FontSize="15" FontFamily="Segoe UI"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             CaretBrush="{StaticResource AccentPrimaryBrush}"
                             SelectionBrush="{StaticResource AccentPrimaryBrush}" />

                    <!-- Panel footer -->
                    <Border Grid.Row="2" Padding="14,8" 
                            BorderBrush="#FF3A3A60" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock Text="{Binding CharacterCount, StringFormat='{}{0} ký tự'}"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center" />
                            <Button Content="✕ Xóa" Style="{StaticResource ModernButton}"
                                    Command="{Binding ClearCommand}"
                                    Padding="10,3" FontSize="11" 
                                    HorizontalAlignment="Right" DockPanel.Dock="Right" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Target panel -->
            <Border Grid.Column="2" Background="#FF1E2045" CornerRadius="10"
                    BorderBrush="#FF3A3A60" BorderThickness="1" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Panel header -->
                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="#FF3A3A60" BorderThickness="0,0,0,1">
                        <TextBlock Text="BẢN DỊCH" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" 
                                   />
                    </Border>

                    <!-- Translated text -->
                    <TextBox Grid.Row="1"
                             Text="{Binding TranslatedText, Mode=OneWay}"
                             Background="Transparent" Foreground="#FFFFFFFF"
                             BorderThickness="0" Padding="14,10"
                             FontSize="15" FontFamily="Segoe UI"
                             TextWrapping="Wrap" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             SelectionBrush="{StaticResource AccentPrimaryBrush}" />

                    <!-- Panel footer -->
                    <Border Grid.Row="2" Padding="14,8"
                            BorderBrush="#FF3A3A60" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Content="📋 Copy" Style="{StaticResource ModernButton}"
                                    Command="{Binding CopyResultCommand}"
                                    Padding="10,3" FontSize="11"
                                    HorizontalAlignment="Right" DockPanel.Dock="Right" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== BOTTOM ACTION BAR ===== -->
        <Border Grid.Row="3" Padding="20,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF181930" Offset="0" />
                    <GradientStop Color="#FF252648" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Loading spinner -->
                    <TextBlock Text="⟳" FontSize="14" Foreground="{StaticResource AccentPrimaryBrush}"
                               Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}"
                               Margin="0,0,8,0">
                        <TextBlock.RenderTransform>
                            <RotateTransform CenterX="7" CenterY="8" />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                            Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="360" Duration="0:0:0.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="#FFBBBBD4" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="#20FFFFFF" CornerRadius="4" Padding="8,4" Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <TextBlock FontSize="10" Foreground="#889999BB">
                            <Run Text="Ctrl+Enter" FontWeight="SemiBold" Foreground="#AA9999BB" />
                            <Run Text=" dịch" />
                            <Run Text="  ·  " />
                            <Run Text="Ctrl+Q" FontWeight="SemiBold" Foreground="#AA9999BB" />
                            <Run Text=" popup" />
                        </TextBlock>
                    </Border>
                    <Button Content="▶  Dịch ngay" Style="{StaticResource AccentButton}"
                            Command="{Binding TranslateCommand}"
                            Padding="24,8" FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
