<Window x:Class="XTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XTranslate" 
        Height="520" Width="860" MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.InputBindings>
        <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding TranslateCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Header -->
            <RowDefinition Height="Auto" />   <!-- Language bar -->
            <RowDefinition Height="*" />       <!-- Translation panels -->
            <RowDefinition Height="Auto" />   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Padding="16,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF1E1F3B" Offset="0" />
                    <GradientStop Color="#FF2A2B50" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✦" FontSize="20" Foreground="{StaticResource AccentPrimaryBrush}" 
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="XTranslate" FontSize="18" FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="  v1.0" FontSize="11" 
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,2,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="⚙ Cài đặt" Style="{StaticResource ModernButton}"
                            Click="SettingsButton_Click" Padding="12,6" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== LANGUAGE BAR ===== -->
        <Border Grid.Row="1" Background="{StaticResource BgSecondaryBrush}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Source language -->
                <ComboBox Grid.Column="0" Style="{StaticResource ModernComboBox}"
                          ItemsSource="{Binding SourceLanguages}"
                          SelectedItem="{Binding SourceLanguage}"
                          DisplayMemberPath="Name"
                          HorizontalAlignment="Center" MinWidth="180" />

                <!-- Swap button -->
                <Button Grid.Column="1" Content="⇄" FontSize="18" FontWeight="Bold"
                        Style="{StaticResource ModernButton}"
                        Command="{Binding SwapLanguagesCommand}"
                        Padding="12,4" Margin="8,0"
                        ToolTip="Đổi ngôn ngữ" />

                <!-- Target language -->
                <ComboBox Grid.Column="2" Style="{StaticResource ModernComboBox}"
                          ItemsSource="{Binding TargetLanguages}"
                          SelectedItem="{Binding TargetLanguage}"
                          DisplayMemberPath="Name"
                          HorizontalAlignment="Center" MinWidth="180" />
            </Grid>
        </Border>

        <!-- ===== TRANSLATION PANELS ===== -->
        <Grid Grid.Row="2" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Source panel -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Văn bản gốc" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,6" />

                <TextBox Grid.Row="1" Style="{StaticResource TranslationTextBox}"
                         Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Stretch" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,6,0,0">
                    <TextBlock Text="{Binding CharacterCount, StringFormat='{}{0} ký tự'}"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                    <Button Content="✕ Xóa" Style="{StaticResource ModernButton}"
                            Command="{Binding ClearCommand}"
                            Padding="8,2" FontSize="11" Margin="12,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- Target panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Bản dịch" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,6" />

                <TextBox Grid.Row="1" Style="{StaticResource TranslationTextBox}"
                         Text="{Binding TranslatedText, Mode=OneWay}"
                         IsReadOnly="True" VerticalAlignment="Stretch" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,4,0">
                    <Button Content="📋 Copy" Style="{StaticResource ModernButton}"
                            Command="{Binding CopyResultCommand}"
                            Padding="8,2" FontSize="11" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== BOTTOM BAR ===== -->
        <Border Grid.Row="3" Background="{StaticResource BgSecondaryBrush}" Padding="16,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Loading indicator -->
                    <TextBlock Text="⟳" FontSize="14" Foreground="{StaticResource AccentPrimaryBrush}"
                               Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}"
                               Margin="0,0,6,0">
                        <TextBlock.RenderTransform>
                            <RotateTransform CenterX="7" CenterY="8" />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                            Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="360" Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Ctrl+Enter để dịch  |  Ctrl+Q popup" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Button Content="▶ Dịch" Style="{StaticResource AccentButton}"
                            Command="{Binding TranslateCommand}"
                            Padding="20,6" FontSize="13" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
