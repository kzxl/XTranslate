<Window x:Class="XTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XTranslate" 
        Height="560" Width="900"
        MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Padding="20,14" Background="#FF161822">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✦" FontSize="22" Foreground="{StaticResource AccentPrimaryBrush}" 
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="XTranslate" FontSize="20" FontWeight="Bold" 
                               Foreground="#FFF1F5F9" VerticalAlignment="Center" />
                    <Border Background="#20818CF8" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="v1.1" FontSize="10" Foreground="#FF818CF8" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- History toggle -->
                    <Button x:Name="HistoryToggleButton" Content="🕒 Lịch sử" Style="{StaticResource ModernButton}"
                            Click="HistoryToggleButton_Click" Padding="14,7" FontSize="12"
                            Margin="0,0,8,0"
                            ToolTip="Hiện/ẩn lịch sử dịch"
                            AutomationProperties.Name="Hiện hoặc ẩn lịch sử dịch" />
                    <!-- OCR Button -->
                    <Button Content="📷 OCR" Style="{StaticResource ModernButton}"
                            Click="OcrButton_Click" Padding="14,7" FontSize="12" 
                            Margin="0,0,8,0"
                            ToolTip="Chụp màn hình và dịch (Ctrl+Shift+Q)" />
                    <Button Content="⚙ Cài đặt" Style="{StaticResource ModernButton}"
                            Click="SettingsButton_Click" Padding="14,7" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== LANGUAGE SELECTOR ===== -->
        <Border Grid.Row="1" Padding="20,12" Background="#FF131520">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" Style="{StaticResource DarkComboBox}"
                          ItemsSource="{Binding SourceLanguages}"
                          SelectedItem="{Binding SourceLanguage}"
                          DisplayMemberPath="Name"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          HorizontalAlignment="Center" MinWidth="200" />

                <Button Grid.Column="1" Content="⇄" FontSize="20" FontWeight="Bold"
                        Style="{StaticResource ModernButton}"
                        Command="{Binding SwapLanguagesCommand}"
                        Padding="14,6" Margin="12,0"
                        ToolTip="Đổi ngôn ngữ nguồn ↔ đích" />

                <ComboBox Grid.Column="2" Style="{StaticResource DarkComboBox}"
                          ItemsSource="{Binding TargetLanguages}"
                          SelectedItem="{Binding TargetLanguage}"
                          DisplayMemberPath="Name"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          HorizontalAlignment="Center" MinWidth="200" />
            </Grid>
        </Border>

        <!-- ===== TRANSLATION PANELS + HISTORY ===== -->
        <Grid Grid.Row="2" Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Translation panels -->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Source panel -->
                <Border Grid.Column="0" Background="#FF161822" CornerRadius="12"
                        BorderBrush="#FF1E293B" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,10" BorderBrush="#FF1E293B" BorderThickness="0,0,0,1">
                        <TextBlock Text="VĂN BẢN GỐC" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource AccentPrimaryBrush}" />
                    </Border>

                    <TextBox Grid.Row="1"
                             Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" Foreground="#FFF1F5F9"
                             BorderThickness="0" Padding="16,12"
                             FontSize="15" FontFamily="Segoe UI"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             CaretBrush="{StaticResource AccentPrimaryBrush}"
                             SelectionBrush="{StaticResource AccentPrimaryBrush}" />

                    <Border Grid.Row="2" Padding="16,8" BorderBrush="#FF1E293B" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock Text="{Binding CharacterCount, StringFormat='{}{0} ký tự'}"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                <Button Content="🔊" Style="{StaticResource ModernButton}"
                                        Command="{Binding SpeakSourceCommand}"
                                        Padding="9,4" FontSize="11" Margin="0,0,6,0"
                                        ToolTip="Phát âm văn bản gốc"
                                        AutomationProperties.Name="Phát âm văn bản gốc"
                                        Visibility="{Binding CanSpeak, Converter={StaticResource BoolToVis}}" />
                                <Button Content="✕ Xóa" Style="{StaticResource ModernButton}"
                                        Command="{Binding ClearCommand}"
                                        Padding="10,4" FontSize="11"
                                        ToolTip="Xóa văn bản"
                                        AutomationProperties.Name="Xóa văn bản" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Target panel -->
            <Border Grid.Column="2" Background="#FF161822" CornerRadius="12"
                    BorderBrush="#FF1E293B" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,10" BorderBrush="#FF1E293B" BorderThickness="0,1,0,1">
                        <TextBlock Text="BẢN DỊCH" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </Border>

                    <Grid Grid.Row="1">
                        <TextBox Text="{Binding TranslatedText, Mode=OneWay}"
                                 Background="Transparent" Foreground="#FFF1F5F9"
                                 BorderThickness="0" Padding="16,12"
                                 FontSize="15" FontFamily="Segoe UI"
                                 TextWrapping="Wrap" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 SelectionBrush="{StaticResource AccentPrimaryBrush}" />

                        <!-- Empty-state placeholder -->
                        <TextBlock Text="Bản dịch sẽ hiển thị ở đây"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="13" IsHitTestVisible="False"
                                   Margin="16,14,16,0" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TranslatedText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="2" Padding="16,8" BorderBrush="#FF1E293B" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                <Button Content="🔊" Style="{StaticResource ModernButton}"
                                        Command="{Binding SpeakResultCommand}"
                                        Padding="9,4" FontSize="11" Margin="0,0,6,0"
                                        ToolTip="Phát âm bản dịch"
                                        AutomationProperties.Name="Phát âm bản dịch"
                                        Visibility="{Binding CanSpeak, Converter={StaticResource BoolToVis}}" />
                                <Button Content="📋 Copy" Style="{StaticResource ModernButton}"
                                        Command="{Binding CopyResultCommand}"
                                        Padding="10,4" FontSize="11"
                                        ToolTip="Sao chép bản dịch"
                                        AutomationProperties.Name="Sao chép bản dịch" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
            </Grid>

            <!-- History sidebar (collapsible) -->
            <Border x:Name="HistoryPanel" Grid.Column="1" Width="260" Margin="16,0,0,0"
                    Background="#FF161822" CornerRadius="12"
                    BorderBrush="#FF1E293B" BorderThickness="1"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,10" BorderBrush="#FF1E293B" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock Text="LỊCH SỬ" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                       Text="🗑" FontSize="13" Cursor="Hand"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       ToolTip="Xóa toàn bộ lịch sử"
                                       MouseLeftButtonUp="ClearHistory_Click" />
                        </DockPanel>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="HistoryList"
                             ItemsSource="{Binding History}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="HistoryList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="10,7">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FF1E2030" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FF2A2D45" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Preview}" FontSize="12.5"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TranslatedText}" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,3,0,0">
                                        <Run Text="{Binding TargetLanguageCode}" />
                                        <Run Text="  •  " />
                                        <Run Text="{Binding Timestamp, StringFormat='HH:mm dd/MM'}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1" Text="Chưa có lịch sử dịch"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding History.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Row="2" Padding="14,8" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Nhấp đúp để dùng lại" />
                </Grid>
            </Border>
        </Grid>

        <!-- ===== BOTTOM BAR ===== -->
        <Border Grid.Row="3" Padding="20,10" Background="#FF131520">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Animated spinner -->
                    <TextBlock Text="⟳" FontSize="14" Foreground="{StaticResource AccentPrimaryBrush}"
                               Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}"
                               Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                            Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="360" Duration="0:0:0.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock x:Name="txtStatus" Text="{Binding StatusText}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="#15818CF8" CornerRadius="6" Padding="10,5" Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <TextBlock FontSize="10" Foreground="#FF64748B">
                            <Run Text="Ctrl+Enter" FontWeight="SemiBold" Foreground="#FF818CF8" />
                            <Run Text=" dịch  ·  " />
                            <Run Text="Ctrl+Q" FontWeight="SemiBold" Foreground="#FF818CF8" />
                            <Run Text=" popup  ·  " />
                            <Run Text="Ctrl+Shift+Q" FontWeight="SemiBold" Foreground="#FF818CF8" />
                            <Run Text=" OCR" />
                        </TextBlock>
                    </Border>
                    <Button Content="▶  Dịch ngay" Style="{StaticResource AccentButton}"
                            Command="{Binding TranslateCommand}"
                            Padding="24,9" FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
