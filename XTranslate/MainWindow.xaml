<Window x:Class="XTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XTranslate" 
        Height="560" Width="900" MinHeight="420" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Padding="20,14" Background="#FF161822">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✦" FontSize="22" Foreground="{StaticResource AccentPrimaryBrush}" 
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="XTranslate" FontSize="20" FontWeight="Bold" 
                               Foreground="#FFF1F5F9" VerticalAlignment="Center" />
                    <Border Background="#20818CF8" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="v1.0" FontSize="10" Foreground="#FF818CF8" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="⚙ Cài đặt" Style="{StaticResource ModernButton}"
                            Click="SettingsButton_Click" Padding="14,7" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== LANGUAGE SELECTOR ===== -->
        <Border Grid.Row="1" Padding="20,12" Background="#FF131520">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" Style="{StaticResource DarkComboBox}"
                          ItemsSource="{Binding SourceLanguages}"
                          SelectedItem="{Binding SourceLanguage}"
                          DisplayMemberPath="Name"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          HorizontalAlignment="Center" MinWidth="200" />

                <Button Grid.Column="1" Content="⇄" FontSize="20" FontWeight="Bold"
                        Style="{StaticResource ModernButton}"
                        Command="{Binding SwapLanguagesCommand}"
                        Padding="14,6" Margin="12,0"
                        ToolTip="Đổi ngôn ngữ nguồn ↔ đích" />

                <ComboBox Grid.Column="2" Style="{StaticResource DarkComboBox}"
                          ItemsSource="{Binding TargetLanguages}"
                          SelectedItem="{Binding TargetLanguage}"
                          DisplayMemberPath="Name"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          HorizontalAlignment="Center" MinWidth="200" />
            </Grid>
        </Border>

        <!-- ===== TRANSLATION PANELS ===== -->
        <Grid Grid.Row="2" Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Source panel -->
            <Border Grid.Column="0" Background="#FF161822" CornerRadius="12"
                    BorderBrush="#FF1E293B" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,10" BorderBrush="#FF1E293B" BorderThickness="0,0,0,1">
                        <TextBlock Text="VĂN BẢN GỐC" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource AccentPrimaryBrush}" />
                    </Border>

                    <TextBox Grid.Row="1"
                             Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" Foreground="#FFF1F5F9"
                             BorderThickness="0" Padding="16,12"
                             FontSize="15" FontFamily="Segoe UI"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             CaretBrush="{StaticResource AccentPrimaryBrush}"
                             SelectionBrush="{StaticResource AccentPrimaryBrush}" />

                    <Border Grid.Row="2" Padding="16,8" BorderBrush="#FF1E293B" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock Text="{Binding CharacterCount, StringFormat='{}{0} ký tự'}"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center" />
                            <Button Content="✕ Xóa" Style="{StaticResource ModernButton}"
                                    Command="{Binding ClearCommand}"
                                    Padding="10,4" FontSize="11" 
                                    HorizontalAlignment="Right" DockPanel.Dock="Right" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Target panel -->
            <Border Grid.Column="2" Background="#FF161822" CornerRadius="12"
                    BorderBrush="#FF1E293B" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,10" BorderBrush="#FF1E293B" BorderThickness="0,0,0,1">
                        <TextBlock Text="BẢN DỊCH" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </Border>

                    <TextBox Grid.Row="1"
                             Text="{Binding TranslatedText, Mode=OneWay}"
                             Background="Transparent" Foreground="#FFF1F5F9"
                             BorderThickness="0" Padding="16,12"
                             FontSize="15" FontFamily="Segoe UI"
                             TextWrapping="Wrap" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             SelectionBrush="{StaticResource AccentPrimaryBrush}" />

                    <Border Grid.Row="2" Padding="16,8" BorderBrush="#FF1E293B" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Content="📋 Copy" Style="{StaticResource ModernButton}"
                                    Command="{Binding CopyResultCommand}"
                                    Padding="10,4" FontSize="11"
                                    HorizontalAlignment="Right" DockPanel.Dock="Right" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== BOTTOM BAR ===== -->
        <Border Grid.Row="3" Padding="20,10" Background="#FF131520">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⟳" FontSize="14" Foreground="{StaticResource AccentPrimaryBrush}"
                               Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}"
                               Margin="0,0,8,0">
                        <TextBlock.RenderTransform>
                            <RotateTransform CenterX="7" CenterY="8" />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                            Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="360" Duration="0:0:0.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock x:Name="txtStatus" Text="{Binding StatusText}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="#15818CF8" CornerRadius="6" Padding="10,5" Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <TextBlock FontSize="10" Foreground="#FF64748B">
                            <Run Text="Ctrl+Enter" FontWeight="SemiBold" Foreground="#FF818CF8" />
                            <Run Text=" dịch  ·  " />
                            <Run Text="Ctrl+Q" FontWeight="SemiBold" Foreground="#FF818CF8" />
                            <Run Text=" popup" />
                        </TextBlock>
                    </Border>
                    <Button Content="▶  Dịch ngay" Style="{StaticResource AccentButton}"
                            Command="{Binding TranslateCommand}"
                            Padding="24,9" FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
